# Shop by SCHA — Environment Template (No Secrets Committed)
# Copy this file to .env and supply real values before production deployment.

PORT=3000
DB_PATH=./data/shop_by_scha.sqlite

# Initial Admin Provisioning (Provisioned outside public customer sign-up)
# Change these before running `npm run seed` in a live environment.
ADMIN_EMAIL=admin@shopbyscha.my
ADMIN_PASSWORD=CHANGE_ME_BEFORE_LIVE_LAUNCH

# Store Reporting Defaults
STORE_CURRENCY=MYR
STORE_TIMEZONE=Asia/Kuala_Lumpur

# Optional Transactional Email (SMTP) — Unconnected by default at launch
# When unconnected, notification jobs are persisted in `notification_jobs` with
# idempotency keys and can be retried safely without affecting saved order/payment states.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
