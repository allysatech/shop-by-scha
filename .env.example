# Production environment: no real values belong in this file.
SCHA_ENV=production
PORT=3000
# Neon pooled URL for authoritative commerce data. No SQLite fallback on Vercel.
DATABASE_URL=
SESSION_SECRET=
APP_URL=
JOB_SECRET=
# Object storage is private. Public media is served through /uploads; receipts require ownership.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Real email transport. SMTP flags alone do not mean a message was delivered.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Only for explicit first-time provisioning; never public registration.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Local-only preview: SCHA_ENV=preview, unique SESSION_SECRET, DB_PATH=./data/preview.sqlite
